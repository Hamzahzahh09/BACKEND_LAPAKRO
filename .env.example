# Backend Environment Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here
DB_DATABASE=roblox_store

# Application Configuration
NODE_ENV=development
PORT=3001

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRATION=24h

# Email Configuration (Mailtrap - Development)
MAILTRAP_HOST=live.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USER=your_mailtrap_username
MAILTRAP_PASS=your_mailtrap_password
MAILTRAP_FROM_EMAIL=noreply@lapakro.com

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Optional: Production Email Configuration
# PROD_EMAIL_HOST=smtp.gmail.com
# PROD_EMAIL_PORT=587
# PROD_EMAIL_USER=your_email@gmail.com
# PROD_EMAIL_PASS=your_app_password

# Optional: Error Tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Optional: Redis Configuration (for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# Cors
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Midtrans Payment Gateway
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
